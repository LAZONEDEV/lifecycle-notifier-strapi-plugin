{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "declaration": true,
    "rootDir": "..",
    "baseUrl": ".",
    "outDir": "./dist",
    "emitDeclarationOnly": false
  },
  "include": ["./src", "../common"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__"
  ]
}
